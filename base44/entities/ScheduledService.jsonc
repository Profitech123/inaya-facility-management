{
  "name": "ScheduledService",
  "type": "object",
  "properties": {
    "subscription_id": {
      "type": "string",
      "description": "Reference to parent Subscription"
    },
    "service_id": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "skipped",
        "reassigned"
      ],
      "default": "scheduled"
    },
    "assigned_provider": {
      "type": "string",
      "description": "Provider ID assigned to this service"
    },
    "previous_provider": {
      "type": "string",
      "description": "Previous provider ID if reassigned"
    },
    "reassignment_reason": {
      "type": "string",
      "description": "Reason for provider reassignment"
    },
    "customer_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the customer was notified about this scheduled service"
    },
    "provider_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the provider was notified about this assignment"
    },
    "completion_notes": {
      "type": "string"
    }
  },
  "required": [
    "subscription_id",
    "service_id",
    "scheduled_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.subscription_id": {
            "_in": [
              {
                "entity_name": "Subscription",
                "read": {
                  "$or": [
                    {
                      "data.customer_id": "{{user.id}}"
                    },
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    }
                  ]
                },
                "_output_field": "id"
              }
            ]
          }
        },
        {
          "data.assigned_provider": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_provider": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}