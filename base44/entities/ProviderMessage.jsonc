{
  "name": "ProviderMessage",
  "type": "object",
  "properties": {
    "booking_id": {
      "type": "string",
      "description": "Reference to Booking"
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "provider",
        "customer"
      ],
      "description": "Who sent the message"
    },
    "sender_id": {
      "type": "string",
      "description": "Provider ID or Customer ID"
    },
    "message": {
      "type": "string"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "text",
        "status_update",
        "photo"
      ],
      "default": "text"
    },
    "photo_url": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "booking_id",
    "sender_type",
    "sender_id",
    "message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.booking_id": {
            "_in": [
              {
                "entity_name": "Booking",
                "read": {
                  "$or": [
                    {
                      "created_by_id": "{{user.id}}"
                    },
                    {
                      "data.assigned_provider_id": "{{user.id}}"
                    },
                    {
                      "user_condition": {
                        "role": "admin"
                      }
                    }
                  ]
                },
                "_output_field": "id"
              }
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}