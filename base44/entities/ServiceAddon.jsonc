{
  "name": "ServiceAddon",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Add-on name (e.g., Deep Cleaning, Extra Room)"
    },
    "description": {
      "type": "string"
    },
    "service_id": {
      "type": "string",
      "description": "Reference to parent Service (blank = available for all)"
    },
    "price": {
      "type": "number",
      "description": "Add-on price in AED"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}