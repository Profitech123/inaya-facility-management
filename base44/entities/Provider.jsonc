{
  "name": "Provider",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Provider's full name"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "specialization": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Service categories they handle"
    },
    "assigned_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific service IDs this technician is qualified to perform"
    },
    "profile_image": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "total_jobs_completed": {
      "type": "number",
      "default": 0
    },
    "current_location": {
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      }
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed"
      ],
      "default": "pending",
      "description": "Onboarding progress"
    },
    "onboarding_step": {
      "type": "number",
      "default": 0,
      "description": "Current onboarding step index"
    },
    "bio": {
      "type": "string",
      "description": "Short bio / introduction"
    },
    "years_experience": {
      "type": "number"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_name": {
      "type": "string"
    },
    "bank_iban": {
      "type": "string"
    },
    "bank_swift": {
      "type": "string"
    },
    "document_emirates_id": {
      "type": "string",
      "description": "URL of uploaded Emirates ID"
    },
    "document_passport": {
      "type": "string",
      "description": "URL of uploaded passport"
    },
    "document_trade_license": {
      "type": "string",
      "description": "URL of uploaded trade license"
    },
    "document_certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of uploaded certification documents"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "tutorial_completed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "full_name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}