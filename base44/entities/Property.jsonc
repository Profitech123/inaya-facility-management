{
  "name": "Property",
  "type": "object",
  "properties": {
    "property_type": {
      "type": "string",
      "enum": [
        "villa",
        "apartment",
        "townhouse"
      ],
      "description": "Type of property"
    },
    "address": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "description": "Area/community name"
    },
    "city": {
      "type": "string",
      "default": "Dubai"
    },
    "bedrooms": {
      "type": "number"
    },
    "square_meters": {
      "type": "number"
    },
    "access_notes": {
      "type": "string",
      "description": "Special access instructions"
    },
    "owner_id": {
      "type": "string",
      "description": "Reference to User who owns this property"
    }
  },
  "required": [
    "property_type",
    "address",
    "owner_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}