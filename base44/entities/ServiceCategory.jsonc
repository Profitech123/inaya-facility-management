{
  "name": "ServiceCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name (Soft Services, Hard Services, Specialized Services)"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide-react"
    },
    "display_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}