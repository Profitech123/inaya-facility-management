{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "description": "Action performed (e.g., booking_status_changed, provider_assigned)"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type affected (Booking, Subscription, Service, etc.)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the affected entity"
    },
    "admin_email": {
      "type": "string",
      "description": "Email of the admin who performed the action"
    },
    "admin_name": {
      "type": "string"
    },
    "details": {
      "type": "string",
      "description": "Human-readable description of the change"
    },
    "old_value": {
      "type": "string",
      "description": "Previous value (JSON string if complex)"
    },
    "new_value": {
      "type": "string",
      "description": "New value (JSON string if complex)"
    }
  },
  "required": [
    "action",
    "entity_type",
    "entity_id",
    "admin_email",
    "details"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}